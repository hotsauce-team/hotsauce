# Copy this file to .env and customize values
# Generate secrets with: deno eval "console.log(crypto.randomUUID() + crypto.randomUUID())"

# NODE_ENV=local

# Demo secrets - DO NOT use in production
CMS_CSRF_SECRET=demo-csrf-secret-at-least-32-characters-long
CMS_JWT_SECRET=demo-jwt-secret-at-least-32-characters-long

# Optional S3/MinIO storage (demo)
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_BUCKET=uploads
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# Optional override: path | virtual-hosted
# S3_URL_STYLE=path
