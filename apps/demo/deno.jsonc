{
  "name": "demo-app",
  "version": "0.0.1",

  "tasks": {
    // Seed the database with demo content.
    "seed": "deno run --permission-set=local seed.ts",
    "seed:prod": "deno run --permission-set=prod seed.ts",
    // Start the server.
    "dev": "deno serve --unstable-worker-options --env-file=.env.example --port=3000 --host=0.0.0.0 --permission-set=local server.ts",
    "dev:debug": "DENO_TRACE_PERMISSIONS=1 RUST_BACKTRACE=1 deno serve --unstable-worker-options --env-file=.env.example --port=3000 --host=0.0.0.0 --permission-set=local server.ts",
    "dev:watch": "deno serve --unstable-worker-options --env-file=.env.example --watch --port=3000 --host=0.0.0.0 --permission-set=local server.ts",
    // Bundle components for the block editor (Puck).
    "bundle": "deno bundle --platform browser --minify components.tsx -o admin/components.js",
    "bundle:watch": "deno bundle --platform browser --minify --watch components.tsx -o admin/components.js",
    // Start the server, bundle components, and watch for changes to both.
    "all:watch": "deno task bundle:watch & deno task dev:watch",
    // Start the production server.
    "prod": "deno serve --ignore-env --port=$PORT --host=127.0.0.1 --permission-set=prod server.ts"
  },

  "exports": "./server.ts",

  "permissions": {
    "local": {
      "read": [
        "./admin",
        "./data",
        "./lib",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.15/node_modules/@electric-sql/pglite/dist/pglite.data",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.15/node_modules/@electric-sql/pglite/dist/pglite.wasm",
        "./site/static"
      ],
      "write": [
        "./data"
      ],
      "net": [
        "0.0.0.0:3000", // For Docker
        "127.0.0.1:3000", // For running directly on the host
        "minio:9000", // S3 storage (Docker internal)
        "localhost:9000" // S3 storage (local development)
      ],
      "env": [
        "NODE_ENV",
        "CMS_CSRF_SECRET",
        "CMS_JWT_SECRET",
        "PGLITE_DATA_DIR",
        "S3_ENDPOINT",
        "S3_PUBLIC_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_REGION",
        "S3_URL_STYLE"
      ]
    },
    "prod": {
      "read": [
        "./admin",
        "./lib",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.15/node_modules/@electric-sql/pglite/dist/pglite.data",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.15/node_modules/@electric-sql/pglite/dist/pglite.wasm",
        "./site/static",
        // Server database
        "/opt/apps/hotsauce-demo-data"
      ],
      "write": [
        // Server database
        "/opt/apps/hotsauce-demo-data"
      ],
      "net": [
        "127.0.0.1" // Any port on the local interface - allows for dynamic port
      ],
      "env": [
        "NODE_ENV",
        "PORT",
        "CMS_CSRF_SECRET",
        "CMS_JWT_SECRET",
        "PGLITE_DATA_DIR"
      ]
    }
  },

  "imports": {
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.3.15",
    "hono": "jsr:@hono/hono@^4.11.5",
    "hono/deno": "jsr:@hono/hono@^4.11.5/deno",
    "micromark": "npm:micromark@4.0.2"
  }
}
