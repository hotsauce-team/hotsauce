{
  "name": "puck-editor-example",
  "version": "0.0.1",

  "tasks": {
    "dev": "deno run --env-file=.env.example --permission-set=puck-editor server.ts",
    "dev:watch": "deno run --env-file=.env.example --watch --permission-set=puck-editor server.ts",
    "seed": "deno run --permission-set=puck-editor seed.ts"
  },

  "exports": "./server.ts",

  "permissions": {
    "puck-editor": {
      "read": [
        "./admin",
        "./data",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.15/node_modules/@electric-sql/pglite/dist/pglite.data",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.15/node_modules/@electric-sql/pglite/dist/pglite.wasm"
      ],
      "write": [
        "./data"
      ],
      "net": [
        "127.0.0.1:3000"
      ],
      "env": [
        "CMS_CSRF_SECRET",
        "CMS_JWT_SECRET"
      ]
    }
  },

  "imports": {
    "hono": "jsr:@hono/hono@^4.11.5"
  }
}
