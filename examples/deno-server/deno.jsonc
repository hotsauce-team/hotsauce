{
  "name": "@drizzle-cms/example-deno-server",

  "tasks": {
    "dev": "deno run --env-file=.env.example --permission-set=example-deno-server --unstable-worker-options main.ts",
    "dev:debug": "RUST_BACKTRACE=1 deno run --env-file=.env.example --permission-set=example-deno-server --unstable-worker-options main.ts",
    "dev:watch": "deno run --env-file=.env.example --watch --permission-set=example-deno-server --unstable-worker-options main.ts",
    "seed": "deno run --permission-set=example-deno-server seed.ts"
  },

  "exports": "./main.ts",

  "permissions": {
    "example-deno-server": {
      "read": [
        "./data",
        "../../packages/plugins/audit-log/worker.ts",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.14/node_modules/@electric-sql/pglite/dist/pglite.data",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.14/node_modules/@electric-sql/pglite/dist/pglite.wasm"
      ],
      "write": [
        "./data"
      ],
      "net": [
        "127.0.0.1:3000"
      ],
      "env": [
        "CMS_CSRF_SECRET",
        "CMS_JWT_SECRET"
      ]
    }
  }
}
