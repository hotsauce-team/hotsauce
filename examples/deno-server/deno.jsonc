{
  "name": "@drizzle-cms/example-deno-server",

  "tasks": {
    "dev": "deno run --permission-set=example-deno-server main.ts",
    "dev:watch": "deno run --watch --permission-set=example-deno-server main.ts",
    "seed": "deno run --permission-set=example-deno-server seed.ts"
  },

  // "imports": {
  //   "drizzle-orm": "npm:drizzle-orm@0.38.3",
  //   "@electric-sql/pglite": "npm:@electric-sql/pglite@0.3.14"
  // },

  "exports": "./main.ts",

  "permissions": {
    "example-deno-server": {
      "read": [
        "./data",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.14/node_modules/@electric-sql/pglite/dist/pglite.data",
        "../../node_modules/.deno/@electric-sql+pglite@0.3.14/node_modules/@electric-sql/pglite/dist/pglite.wasm"
      ],
      "write": [
        "./data"
      ],
      "net": [
        "127.0.0.1:3000"
      ]
    }
  }
}
