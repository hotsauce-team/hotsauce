{
  "name": "@hotsauce/plugins",
  "version": "0.1.13",
  "exports": {
    ".": "./mod.ts",
    "./audit-log": "./audit-log/mod.ts",
    "./audit-log/worker": "./audit-log/worker.ts",
    "./puck": "./puck/mod.ts",
    "./puck/types": "./puck/types.ts",
    "./puck/fields": "./puck/fields/mod.ts",
    "./puck/client/globals": "./puck/client/globals.ts",
    "./s3-storage": "./s3-storage/mod.ts",
    "./s3-storage/signing": "./s3-storage/signing.ts",
    "./s3-storage/types": "./s3-storage/types.ts"
  },
  "tasks": {
    "build:puck": "deno run --unstable-bundle --allow-read --allow-write --allow-net puck/build.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "audit-log/",
      "puck/",
      "s3-storage/",
      "README.md",
      "LICENSE"
    ]
  },
  "imports": {
    "@std/media-types": "jsr:@std/media-types@^1.1.0"
  },
  // Explicit lib set required because this package contains browser-targeting code
  // (ImagePickerField React component uses HTMLDialogElement, MessageEvent, etc.).
  //
  // - dom / dom.iterable: browser DOM types for ImagePickerField and puck client
  // - esnext: modern JS built-ins
  // - deno.ns / deno.window: Deno globals needed by test files (Deno.test, etc.)
  //
  // We use compilerOptions here instead of /// <reference lib="dom" /> in source
  // because JSR bans triple-slash directives that modify the global type environment.
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns", "deno.window"]
  }
}
