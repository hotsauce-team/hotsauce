{
  "cSpell.words": [
    "BYOS",
    "HMAC",
    "hotsauce",
    "Introspected",
    "nosniff",
    "pglite",
    "presign",
    "varchar",
    "vars",
    "vendored"
  ],
  "chat.tools.terminal.autoApprove": {
    "/^deno task \\w+ 2>&1( \\| (head|tail) -\\d+)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^deno test -P$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^deno test -P (?!.*\\.\\.)[\\w.\\/-]+\\.ts 2>&1( \\| (head|tail) -\\d+)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^deno test -P 2>&1 \\| (head|tail) -\\d+$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^deno check [\\w.\\/*-\\s]+ 2>&1 \\| (head|tail) -\\d+$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^deno check [\\w.\\/*-\\s]+ 2>&1$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^deno check 2>&1 \\| (head|tail) -\\d+$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^deno task test$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "chat.agent.maxRequests": 250
}
